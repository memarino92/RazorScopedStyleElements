<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>RazorInlineCss</PackageId>
    <Version>0.1.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- MSBuild task assemblies are intentionally loaded by build/RazorInlineCss.targets, not referenced by consumers. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RazorInlineCss.Tasks/RazorInlineCss.Tasks.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="build/RazorInlineCss.props" Pack="true" PackagePath="build/RazorInlineCss.props" />
    <None Include="build/RazorInlineCss.targets" Pack="true" PackagePath="build/RazorInlineCss.targets" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../RazorInlineCss.Tasks/bin/$(Configuration)/net10.0/RazorInlineCss.Tasks.dll"
          Pack="true"
          PackagePath="tasks/net10.0/RazorInlineCss.Tasks.dll"
          Visible="false" />
  </ItemGroup>

</Project>
