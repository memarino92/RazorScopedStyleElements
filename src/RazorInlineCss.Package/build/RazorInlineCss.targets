<Project>
  <UsingTask TaskName="RazorInlineCss.Tasks.GenerateProofScopedCss"
             AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\net10.0\RazorInlineCss.Tasks.dll" />

  <!-- ComputeCssScope is the first scoped-CSS stage that consumes ScopedCssInput. -->
  <Target Name="GenerateRazorInlineCssProof"
          BeforeTargets="ComputeCssScope"
          DependsOnTargets="ResolveRazorComponentInputs"
          Condition="'$(RazorInlineCssEnabled)' == 'true'">
    <PropertyGroup>
      <_RazorInlineCssOutputPath Condition="'$(RazorInlineCssIntermediateOutputPath)' == ''">$(IntermediateOutputPath)RazorInlineCss\</_RazorInlineCssOutputPath>
      <_RazorInlineCssOutputPath Condition="'$(RazorInlineCssIntermediateOutputPath)' != ''">$(RazorInlineCssIntermediateOutputPath)</_RazorInlineCssOutputPath>
    </PropertyGroup>

    <GenerateProofScopedCss RazorComponents="@(RazorComponent)"
                            OutputDirectory="$(_RazorInlineCssOutputPath)">
      <Output TaskParameter="GeneratedCss" ItemName="_RazorInlineCssGeneratedCss" />
    </GenerateProofScopedCss>

    <ItemGroup>
      <ScopedCssInput Include="@(_RazorInlineCssGeneratedCss)" />
      <FileWrites Include="@(_RazorInlineCssGeneratedCss)" />
    </ItemGroup>
  </Target>
</Project>
